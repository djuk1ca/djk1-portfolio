{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "djk1-portfolio",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "djk1-inquiries",
      // Replace with the id printed by `npx wrangler d1 create djk1-inquiries` before the first deploy.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // SITE_URL and TURNSTILE_SITE_KEY are build-time env vars (prerendered pages), not set here. See README.
    "NOTIFY_EMAIL": "djuradj.manojlovic04@gmail.com"
  }
  // Secrets (wrangler secret put …): TURNSTILE_SECRET, RESEND_API_KEY, IP_SALT
}
