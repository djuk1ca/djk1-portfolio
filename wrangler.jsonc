{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "djk1-portfolio",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "djk1-inquiries",
      "database_id": "20a81d40-8585-4e49-b785-f8675f1a1965",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // SITE_URL and TURNSTILE_SITE_KEY are build-time values (prerendered pages): see scripts/cf-build.mjs.
    "NOTIFY_EMAIL": "djuradj.manojlovic04@gmail.com"
  }
  // Secrets (wrangler secret put …): TURNSTILE_SECRET, RESEND_API_KEY, IP_SALT
}
